# ==============================================================================
# AspirantAI Frontend Environment Variables (.env.example)
# Note: In Vite, only variables prefixed with VITE_ are exposed to client code.
# Never expose secrets, private keys, or database credentials here.
# ==============================================================================

# Backend API Base URL
# In local development: http://localhost:5001/api/v1 (or leave blank to use Vite reverse proxy)
# In production on Vercel: https://<your-render-backend-url>/api/v1
VITE_API_BASE_URL=http://localhost:5001/api/v1

# Real-time WebSocket Gateway URL
# In local development: http://localhost:5001
# In production on Vercel: https://<your-render-backend-url>
VITE_SOCKET_URL=http://localhost:5001
