# ==============================================================================
# AspirantAI Backend Environment Variables (.env.example)
# Note: Never commit secrets or actual production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server Configuration (Required)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://localhost:27017/aspirantai
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Authentication Secrets (Required)
# ------------------------------------------------------------------------------
JWT_SECRET=aspirantai_jwt_super_secure_development_secret_key_2026
SESSION_SECRET=aspirantai_jwt_super_secure_development_secret_key_2026

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (Optional)
# Where to obtain: Google Cloud Console -> APIs & Services -> Credentials
# Authorized Redirect URI: http://localhost:5001/api/v1/auth/google/callback
# In Production: https://<your-backend-domain>/api/v1/auth/google/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# GitHub OAuth 2.0 Credentials (Optional)
# Where to obtain: GitHub -> Settings -> Developer settings -> OAuth Apps
# Authorization callback URL: http://localhost:5001/api/v1/auth/github/callback
# In Production: https://<your-backend-domain>/api/v1/auth/github/callback
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5001/api/v1/auth/github/callback

# ------------------------------------------------------------------------------
# AI Provider Credentials (Optional)
# Where to obtain: Google AI Studio (https://aistudio.google.com) - Free Tier available
# Model: gemini-flash-lite-latest (fastest), gemini-3.5-flash-lite, gemini-3.1-flash-lite
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# OpenAI API Key (Optional Fallback)
# Where to obtain: OpenAI Platform (https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Sandboxed Code Execution Provider (Optional)
# Where to obtain: RapidAPI Judge0 CE (https://rapidapi.com/hermanzdosilovic/api/judge0-ce)
# or self-hosted Judge0 instance
# When omitted: Platform reports 'Runner Unconfigured' and records submissions safely.
# ------------------------------------------------------------------------------
JUDGE0_API_URL=
JUDGE0_API_KEY=

# ------------------------------------------------------------------------------
# YouTube Educational Data API (Optional)
# Where to obtain: Google Cloud Console -> Enable YouTube Data API v3
# When omitted: Platform serves curated official playlists directly through embed links.
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=

# ------------------------------------------------------------------------------
# Email / Notification Provider (Optional)
# Where to obtain: SendGrid, Resend, or standard SMTP
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=support@aspirantai.in
RESEND_API_KEY=
