# ==============================================================================
# AspirantAI Full-Stack Platform — Central Environment Guide (.env.example)
# ==============================================================================
# AspirantAI separates frontend client variables from backend server variables.
# 1. Server configuration lives in server/.env
# 2. Client configuration lives in client/.env
# ==============================================================================

# --- BACKEND (server/.env) ---
# Required:
# NODE_ENV=development
# PORT=5000
# MONGODB_URI=mongodb://localhost:27017/aspirantai  (or your MongoDB Atlas connection string)
# CLIENT_URL=http://localhost:5173
# JWT_SECRET=aspirantai_jwt_super_secure_development_secret_key_2026

# Google OAuth 2.0 (Optional):
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# GitHub OAuth 2.0 (Optional):
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# AI Intelligence & Model Runner (Optional):
# GEMINI_API_KEY=your-gemini-api-key

# Judge0 Sandboxed Multi-Language Code Runner (Optional):
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your-rapidapi-key

# YouTube Educational Data API (Optional):
# YOUTUBE_API_KEY=your-youtube-api-key

# Email / Notifications (Optional):
# RESEND_API_KEY=re_...
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASS=your-password
# EMAIL_FROM=support@aspirantai.in

# --- FRONTEND (client/.env) ---
# VITE_API_BASE_URL=http://localhost:5000/api/v1
# VITE_SOCKET_URL=http://localhost:5000
